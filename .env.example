# Copy to .env to override defaults. All values are optional.
# Precedence: built-in defaults < config.json < environment variables.

# FMF_DB_PATH=data/mods.db
# FMF_HOST=127.0.0.1
# FMF_PORT=3000

# Mod portal politeness settings
# FMF_REQUESTS_PER_SECOND=3
# FMF_CONCURRENCY=2
# FMF_USER_AGENT=

# Game version whose mods get full details during sync ("latest" or e.g. "2.0")
# FMF_GAME_VERSION=latest

# Theme search embeddings: transformers (local, default) | ollama | openai | none
# FMF_EMBEDDINGS_PROVIDER=transformers
# FMF_EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
# FMF_EMBEDDINGS_BASE_URL=
# FMF_EMBEDDINGS_API_KEY=

# Ask AI (chat LLM): none | openai (any OpenAI-compatible API) | anthropic
# These can also be set from the Settings dialog in the app.
# FMF_LLM_PROVIDER=openai
# FMF_LLM_BASE_URL=http://127.0.0.1:11434/v1
# FMF_LLM_MODEL=qwen2.5:7b
# FMF_LLM_API_KEY=
